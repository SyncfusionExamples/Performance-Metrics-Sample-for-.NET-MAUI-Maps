<ContentPage
    x:Class="ShapeLayerPerformanceSample.CustomMarkerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    Title="Custom Marker Page">

    <ContentPage.Resources>
        <DataTemplate x:Key="CustomMarkerTemplate">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Image HeightRequest="20" Source="pin.png"  WidthRequest="20" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid Padding="10" RowDefinitions="Auto,*" RowSpacing="10">
        <Border Grid.Row="0" Padding="12" BackgroundColor="#F2F2F2" Stroke="#D0D0D0">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="CustomMarkerCountLabel" Text="Custom Marker Count: 0" />
                <Label x:Name="CustomMarkerTimeLabel"  FontAttributes="Bold" Text="Custom Marker Load Time: Waiting..."  HorizontalOptions="{OnPlatform WinUI=Start, MacCatalyst=Start}" VerticalOptions="{OnPlatform WinUI=Center, MacCatalyst=Center}"/>
                <Button x:Name="LoadCustomMarkersButton" Clicked="LoadCustomMarkersButton_Clicked"  Text="Load 100 Custom Markers"  HorizontalOptions="{OnPlatform WinUI=Start, MacCatalyst=Start}" VerticalOptions="{OnPlatform WinUI=Center, MacCatalyst=Center}"/>
            </VerticalStackLayout>
        </Border>

        <maps:SfMaps x:Name="maps" Grid.Row="1">
            <maps:SfMaps.Layer>
                <maps:MapShapeLayer  x:Name="shapeLayer" MarkerTemplate="{StaticResource CustomMarkerTemplate}" ShapeFill="#D8E9F3" ShapeStroke="#666666" ShapeStrokeThickness="1" ShapesSource="https://cdn.syncfusion.com/maps/map-data/world-map.json" />
            </maps:SfMaps.Layer>
        </maps:SfMaps>
    </Grid>

</ContentPage>