<ContentPage
    x:Class="ShapeLayerPerformanceSample.ZoomPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    Title="Zoom Page">

    <Grid Padding="10" RowDefinitions="Auto,*" RowSpacing="10">
        <Border Grid.Row="0" Padding="12" BackgroundColor="#F2F2F2" Stroke="#D0D0D0">
            <VerticalStackLayout Spacing="8">
                <Label  x:Name="ZoomTimeLabel" FontAttributes="Bold" Text="Zoom Render Time: Waiting..." />
                <Button  x:Name="RunZoomButton"  Clicked="RunZoomButton_Clicked" Text="Run Zoom Performance" HorizontalOptions="{OnPlatform WinUI=Start, MacCatalyst=Start}" VerticalOptions="{OnPlatform WinUI=Center, MacCatalyst=Center}"/>
            </VerticalStackLayout>
        </Border>

        <maps:SfMaps x:Name="maps" Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="Fill">
            <maps:SfMaps.Layer>
                <maps:MapShapeLayer x:Name="shapeLayer" EnableZoomingAnimation="False" ShapeFill="#D8E9F3" ShapeStroke="#666666" ShapeStrokeThickness="1" ShapesSource="https://cdn.syncfusion.com/maps/map-data/world-map.json" >
                    <maps:MapShapeLayer.ZoomPanBehavior>
                        <maps:MapZoomPanBehavior  x:Name="zoomPanBehavior" EnablePanning="True" EnableZooming="True" MinZoomLevel="1" MaxZoomLevel="6" ZoomLevel="1" />
                    </maps:MapShapeLayer.ZoomPanBehavior>
                </maps:MapShapeLayer>
            </maps:SfMaps.Layer>
        </maps:SfMaps>
    </Grid>
</ContentPage>