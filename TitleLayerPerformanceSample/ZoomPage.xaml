<ContentPage
    x:Class="TitleLayerPerformanceSample.ZoomPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
    Title="Zoom Page">

    <Grid Padding="10" RowDefinitions="Auto,*"  RowSpacing="10">
        <Border Grid.Row="0"  Padding="12" BackgroundColor="#F2F2F2" Stroke="#D0D0D0" StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Label x:Name="ZoomTimeLabel" FontAttributes="Bold" Text="Zoom Render Time: Waiting..." TextColor="Black" />
                <Button x:Name="RunZoomButton" Clicked="RunZoomButton_Clicked"  Text="Run Zoom Performance" HorizontalOptions="{OnPlatform WinUI=Start, MacCatalyst=Start}" VerticalOptions="{OnPlatform WinUI=Center, MacCatalyst=Center}" />
            </VerticalStackLayout>
        </Border>

        <maps:SfMaps x:Name="maps" Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="Fill">
            <maps:SfMaps.Layer>
                <maps:MapTileLayer x:Name="tileLayer" EnableCenterAnimation="False" EnableZoomingAnimation="False" UrlTemplate="https://tile.openstreetmap.org/{z}/{x}/{y}.png">
                    <maps:MapTileLayer.ZoomPanBehavior>
                        <maps:MapZoomPanBehavior x:Name="zoomPanBehavior"/>
                    </maps:MapTileLayer.ZoomPanBehavior>
                </maps:MapTileLayer>
            </maps:SfMaps.Layer>
        </maps:SfMaps>

    </Grid>

</ContentPage>